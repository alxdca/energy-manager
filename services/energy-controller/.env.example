# Monitoring works without enabling application control.
FRONIUS_INVERTER_IP=192.168.1.1
FRONIUS_INVERTER_PORT=80
FRONIUS_MODBUS_PORT=502
FRONIUS_MODBUS_UNIT_ID=1
FRONIUS_MODBUS_MODE=int

# Writes are disabled by default. To enable them, set true, choose a power
# ceiling appropriate for the installed system.
FRONIUS_CONTROL_ENABLED=false
# FRONIUS_MAX_POWER_WATTS=

# Positive set-charge-power runs until 100% SOC or explicit stop, with safety supervision.
# Discharge uses the inverter-reported reserve; there is no application minimum SOC.
# The maximum SOC applies to target charging; duration bounds target charging, standby and discharge.
FRONIUS_MAX_SOC_PERCENT=90
FRONIUS_MAX_CONTROL_SECONDS=300
# Finite inverter fallback remains active for every control session.
FRONIUS_REVERT_TIMEOUT_SECONDS=30
FRONIUS_CONTROL_CHECK_SECONDS=5

# Optional local Fronius Wattpilot (classic models; uses Node's native WebSocket).
# Use the local device password, not Fronius account credentials. Keep secrets in .env.
# WATTPILOT_URL=ws://192.168.1.2/ws
# WATTPILOT_PASSWORD=
WATTPILOT_CONTROL_ENABLED=false
# Explicit ceiling required for writes: integer amperes per phase, 6–16 A.
# The adapter also checks the charger/cable limits and confirms requested 1/3-phase changes.
# WATTPILOT_MAX_CURRENT_AMPS=16
WATTPILOT_REQUEST_TIMEOUT_SECONDS=5
# Controller-owned software leases. Blank uses data/wattpilot-automation.json.
# Keep the journal across restarts; it contains ownership, never the device password.
WATTPILOT_AUTOMATION_STATE_PATH=

# Keep loopback binding unless remote access is intentionally configured.
API_HOST=127.0.0.1
API_PORT=3001
SYSTEM_TIMEZONE=Europe/Zurich
