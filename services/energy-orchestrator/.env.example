API_HOST=0.0.0.0
API_PORT=3002

# Dashboard monitors this controller and proxies explicit manual commands.
# Battery writes still require the controller's existing FRONIUS control opt-in and limits.
# Leave blank to show a dashboard without device telemetry.
ENERGY_CONTROLLER_URL=http://127.0.0.1:3001

# Car display name used throughout the dashboard; blank defaults to Voiture.
CAR_NAME=

# Tesla personal account: connect an Owner API refresh token from /appareils.
# No Tesla password or token belongs in this environment file.
# Private token file (atomic rotation, owner read/write); blank uses data/tesla-tokens.json.
TESLA_TOKENS_PATH=
# Optional for one car; required to choose between multiple accessible vehicles.
TESLA_VIN=

# Rough next-day solar forecast (Open-Meteo, personal/non-commercial use).
# Set both coordinates; leave both blank to disable the forecast.
FORECAST_LATITUDE=
FORECAST_LONGITUDE=
FORECAST_LOCATION_NAME=Installation
# best_match or meteoswiss_icon_ch2 (regional hourly model).
FORECAST_WEATHER_MODEL=best_match
FORECAST_SOLAR_CAPACITY_KW=8.5
# PV system factor; separate from battery round-trip efficiency.
FORECAST_PERFORMANCE_RATIO=0.85
# Optional east-west roof: tilt in degrees, not slope percent.
# The confirmed installation uses 15 degrees. Blank keeps the horizontal model.
FORECAST_PANEL_TILT_DEG=
# Share of total installed kWp facing east (0..1); defaults to 0.5 when tilt is set.
FORECAST_EAST_FRACTION=

# Baseline-only household electricity estimate, excluding the car and battery charging.
FORECAST_BASE_LOAD_W=1000

# PostgreSQL is required for runtime history; no automatic JSON fallback.
# This URL matches compose.yaml's loopback-only local development database.
DATABASE_URL=postgresql://energy:energy@127.0.0.1:5434/energy_manager

# Battery automation: explicit opt-in. Fixed 6 kW, quarter-hour planning.
# Build the afternoon SOC goal across both windows, crediting usable solar after household load.
# Buffered charging windows: 23:05–06:55 and 12:05–16:55, Europe/Zurich.
AUTOMATION_ENABLED=false
# Owner-confirmed energy represented by 100% of GEN24-reported SOC.
AUTOMATION_SOC_CAPACITY_KWH=60
# Effective reserve is at least 5%, or a higher configured/verified inverter reserve.
AUTOMATION_RESERVE_SOC_PERCENT=5
# Desired SOC at 16:55; evening coverage can require more, subject to controller limits.
AUTOMATION_AFTERNOON_TARGET_SOC_PERCENT=80
# Buffer is max(minimum, percentage of the next high-tariff net battery needs), above reserve.
AUTOMATION_ENERGY_BUFFER_PERCENT=5
AUTOMATION_ENERGY_BUFFER_MIN_KWH=1
# Stable lease owner and manual override. Blank uses data/automation.json.
AUTOMATION_STATE_PATH=

# Car automation starts in manual mode; enable explicitly with Mode auto in Pilotage.
# Automatic grid charging requires the supervised battery planner above.
CAR_AUTOMATION_CAPACITY_KWH=75
CAR_AUTOMATION_EFFICIENCY=0.9
CAR_AUTOMATION_MAX_CURRENT_AMPS=16
CAR_AUTOMATION_SOC_FRESHNESS_SECONDS=600
CAR_AUTOMATION_LEASE_SECONDS=90
CAR_AUTOMATION_WAKE_COOLDOWN_SECONDS=900
# Private opt-in/session/checkpoint state; blank uses data/car-automation.json.
CAR_AUTOMATION_STATE_PATH=
